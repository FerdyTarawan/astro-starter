{
  "name": "astro-react-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "vp fmt",
    "check": "vp check && astro check",
    "test:e2e": "playwright test",
    "verify": "pnpm run check && pnpm run build && pnpm run test:e2e",
    "hooks:install": "lefthook install",
    "hooks:check": "lefthook run pre-commit",
    "ui:add": "shadcn add",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "2.2.2",
    "oxc-transform-react": "0.152.0",
    "shadcn": "4.22.1",
    "typescript": "6.0.3",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "pnpm@12.15.0"
}
